# Telegram configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TG_ALLOWED_USER_IDS=123456,789012

# GigaChat API credentials and options
GIGACHAT_CREDENTIALS=your_base64_credentials
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_VERIFY_SSL=0

# HuggingFace
HF_TOKEN=your_hf_token_optional
HF_EMBEDDING_MODEL=BAAI/bge-m3

# RAG pipeline settings
FAQ_SOURCE_URL=https://example.com/faq
FAQ_STORAGE_DIR=data
VECTOR_STORE_PATH=storage/faiss_index
TOP_K_RESULTS=4

# Logging
LOG_LEVEL=INFO